{
  "name": "@xinna/botmux-plugin-ferry-gateway",
  "version": "0.2.0",
  "description": "面向已获内部权限用户的 FERRY 适配插件，提供 Codex/TraeX GPT 模型选择、模型转发与同模型加速。",
  "publishConfig": { "registry": "https://registry.npmjs.org", "access": "public" },
  "engines": { "node": ">=22" },
  "private": false,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinna2001/botmux-plugin-ferry-gateway.git",
    "directory": "gateway"
  },
  "type": "module",
  "keywords": ["botmux-plugin"],
  "files": ["dist", "README.md", "INSTALL.zh-CN.md"],
  "botmux": {
    "schemaVersion": 1,
    "id": "gateway-acceleration",
    "displayName": "FERRY 网关",
    "audience": "仅限字节内部使用",
    "service": { "mode": "auto" }
  },
  "scripts": {
    "build": "node ../build.mjs",
    "test": "node --test ../test/*.test.mjs",
    "test:package": "node ../scripts/verify-package.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "lucide": "0.468.0"
  }
}
