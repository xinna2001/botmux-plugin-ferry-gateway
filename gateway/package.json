  },
  "engines": {
    "node": ">=22"
  },
  "private": false,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinna2001/botmux-plugin-ferry-gateway.git",
    "directory": "gateway"
  },
  "type": "module",
  "keywords": [
    "botmux-plugin"
  ],
  "files": [
    "dist",
    "README.md",
    "INSTALL.zh-CN.md"
  ],
  "botmux": {
