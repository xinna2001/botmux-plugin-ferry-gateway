  "description": "仅限字节内部同学使用，提供 FERRY 模型转发与独立的同模型加速。",
  "publishConfig": { "registry": "https://bnpm.byted.org" },
  "engines": { "node": ">=22" },
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
